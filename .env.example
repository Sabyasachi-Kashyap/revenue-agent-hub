# Copy this file to .env for local dev, and add the same two keys in
# Netlify → Site settings → Environment variables for production.
# Both are SAFE to expose in the browser (Supabase's anon key is public by
# design — real security comes from the Row Level Security policies in
# supabase/migrations/0001_init.sql).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Nothing else goes here. OPENAI_API_KEY / ANTHROPIC_API_KEY / RAPIDAPI_KEY are
# NEVER set as VITE_ variables — they must only exist as Supabase Edge Function
# secrets (see supabase/README.md), or anyone visiting your site could read
# them from the compiled JS bundle.
